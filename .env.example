# Copy thành .env khi chạy local (code vẫn chạy tốt nếu không có file này)
PORT=3000
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
BOOK_SERVICE_PORT=3002
BORROW_SERVICE_PORT=3003
JWT_SECRET=doi-mat-khau-manh-o-day
INTERNAL_SERVICE_SECRET=doi-secret-noi-bo-o-day
NODE_ENV=development
# Chỉ đặt khi deploy có ổ persistent (vd: DATA_DIR=/data), bỏ trống = dùng thư mục data/ local
# DATA_DIR=
# Turso Cloud (SQLite remote, giữ data khi deploy — free, không cần thẻ).
# Tạo 3 DB tại https://turso.tech, lấy URL + token rồi điền vào.
# Service nào không đặt URL thì dùng file local như cũ. Test luôn dùng local.
# TURSO_USER_SERVICE_URL=libsql://...
# TURSO_BOOK_SERVICE_URL=libsql://...
# TURSO_BORROW_SERVICE_URL=libsql://...
# Token Turso thường chỉ có quyền 1 DB → tạo 1 token cho mỗi DB.
# (Nếu token của bạn dùng chung được thì chỉ cần TURSO_TOKEN.)
# TURSO_USER_SERVICE_TOKEN=eyJ...
# TURSO_BOOK_SERVICE_TOKEN=eyJ...
# TURSO_BORROW_SERVICE_TOKEN=eyJ...
# TURSO_TOKEN=eyJ...
